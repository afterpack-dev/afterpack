{
  "name": "@afterpack/nuxt",
  "version": "0.1.0",
  "description": "Nuxt 3 module for AfterPack: obfuscate a Nuxt app's production JavaScript during the build",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0"
  },
  "dependencies": {
    "@afterpack/integration-utils": "workspace:*",
    "@afterpack/vite": "workspace:*",
    "@nuxt/kit": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/node": "^22.0.0",
    "tsdown": "^0.11.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/afterpack-dev/afterpack.git",
    "directory": "packages/nuxt"
  },
  "keywords": [
    "obfuscator",
    "javascript-obfuscator",
    "obfuscation",
    "code-protection",
    "source-code-protection",
    "javascript-security",
    "anti-reverse-engineering",
    "nuxt",
    "nuxt-module",
    "vite",
    "afterpack"
  ],
  "author": "AfterPack (https://www.afterpack.dev)",
  "license": "Apache-2.0",
  "homepage": "https://www.afterpack.dev/docs/frameworks/nuxt",
  "bugs": {
    "url": "https://github.com/afterpack-dev/afterpack/issues"
  }
}
