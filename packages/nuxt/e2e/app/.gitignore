# nuxt fixture -- app SOURCE (app.vue, nuxt.config.ts) is committed; installed
# deps + build output are not. The shared ../.gitignore also covers these;
# repeated here so the AfterPack gitignore guard finds them already present.
node_modules/
.output/
.nuxt/
.data/
dist/
.afterpack-baseline/

# AfterPack artifacts.
.afterpack/
*.protectionMap.html
protectionMap.html
*.backup.*
*.map
dist
