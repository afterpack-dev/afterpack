{
  "name": "@afterpack/protection-map",
  "version": "0.1.0",
  "description": "AfterPack Protection Map viewer: render protection data into a self-contained HTML report",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./template.html": "./template.html"
  },
  "bin": {
    "afterpack-protection-map": "./render.mjs"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "codec.mjs",
    "index.d.ts",
    "index.mjs",
