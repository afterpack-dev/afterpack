{
  "framework": "vite-react",
  "frameworkClass": "spa",
  "description": "Vite 8 + React 19 SPA, a single client bundle plus one lazy route chunk: React Router navigation, a zod-validated form, context state across routes, and notes persisted to localStorage.",
  "seed": 472938102,
  "deterministicOutput": true,
  "build": {
    "outputDir": "dist",
    "bundles": [
      "client"
    ],
    "note": "obfuscation runs automatically via @afterpack/vite's closeBundle hook (vite.config.ts) -- no separate step"
  },
  "obfuscation": {
    "minFiles": 2,
    "passes": 1
  },
  "smoke": {
    "routes": [
      {
        "path": "/",
        "status": 200,
        "textContains": [
          "Vite + React fixture"
        ],
        "selectors": {
          "[data-testid=\"title\"]": "Vite + React fixture",
          "[data-testid=\"intro\"]": "AfterPack framework-integration smoke fixture."
        }
      },
      {
        "path": "/notes",
        "status": 200,
        "selectors": {
          "h1": "Notes"
        }
      },
      {
        "path": "/reports",
        "status": 200,
        "selectors": {
          "[data-testid=\"report-summary\"]": "0 notes, 0 words"
        }
      }
    ],
    "interactions": [
      {
        "route": "/",
        "description": "Counter island increments and re-renders on click.",
        "click": "[data-testid=\"counter\"]",
        "expectTextContains": [
          "count is 1 (odd)"
        ]
      }
    ],
    "consoleErrors": "none"
  }
}
