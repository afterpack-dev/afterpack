# sveltekit fixture -- app SOURCE (src/, configs) is committed; installed deps +
# build output are not. The shared ../.gitignore also covers these; repeated here
# so the AfterPack gitignore guard finds them already present.
node_modules/
build/
.svelte-kit/
.afterpack-baseline/

# AfterPack artifacts.
.afterpack/
*.protectionMap.html
protectionMap.html
*.backup.*
*.map
