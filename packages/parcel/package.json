{
  "name": "@afterpack/parcel-optimizer",
  "version": "0.1.0",
  "description": "AfterPack Parcel 2 optimizer - obfuscate your build output automatically",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@parcel/core": ">=2.9.0"
  },
  "dependencies": {
    "@afterpack/core": "~0.1.0",
    "@afterpack/integration-utils": "workspace:*",
    "@parcel/diagnostic": "^2.9.0",
    "@parcel/plugin": "^2.9.0",
    "@parcel/source-map": "^2.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@parcel/core": "^2.16.0",
    "@parcel/types": "^2.16.0",
    "@types/node": "^22.0.0",
    "tsdown": "^0.11.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18",
    "parcel": "^2.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/afterpack-dev/afterpack.git",
    "directory": "packages/parcel"
  },
  "license": "Apache-2.0",
  "homepage": "https://www.afterpack.dev",
  "bugs": {
    "url": "https://github.com/afterpack-dev/afterpack/issues"
  }
}
