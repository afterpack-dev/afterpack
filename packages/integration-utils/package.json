{
  "name": "@afterpack/integration-utils",
  "version": "0.1.0",
  "description": "Internal shared code for the AfterPack CLI and framework plugins",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@afterpack/protection-map": "workspace:*",
    "@jridgewell/sourcemap-codec": "^1.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/node": "^22.0.0",
    "tsdown": "^0.11.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/afterpack-dev/afterpack.git",
    "directory": "packages/integration-utils"
  },
  "keywords": [
    "obfuscation",
    "obfuscator",
    "javascript-obfuscator",
    "code-protection",
    "source-code-protection",
    "javascript-security",
    "build-tools",
    "source-map",
    "internal",
    "afterpack"
  ],
  "author": "AfterPack (https://www.afterpack.dev)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/afterpack-dev/afterpack",
  "bugs": {
    "url": "https://github.com/afterpack-dev/afterpack/issues"
  }
}
