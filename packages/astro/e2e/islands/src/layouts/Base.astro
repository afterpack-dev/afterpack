---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <nav aria-label="Main">
      <a href="/">Home</a>
      <a href="/notes">Notes</a>
      <a href="/reports">Reports</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  const markReady = () => {
    if (document.querySelector('astro-island[ssr][client="load"]')) {
      requestAnimationFrame(markReady);
      return;
    }
    document.querySelector("main")?.setAttribute("data-app-ready", "");
  };
  document.addEventListener("astro:page-load", markReady);
</script>

<style is:global>
  body {
    margin: 0;
    font: 16px/1.5 system-ui, sans-serif;
  }
  main {
    max-width: 640px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
</style>
