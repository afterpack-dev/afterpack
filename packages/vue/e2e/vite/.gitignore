# vue3-vite fixture -- app SOURCE (src/, index.html, configs) is committed;
# installed deps + build output are not. The shared ../.gitignore also covers
# these; repeated here so the AfterPack gitignore guard finds them already present.
node_modules/
dist/
.afterpack-baseline/

# AfterPack artifacts.
.afterpack/
*.protectionMap.html
protectionMap.html
*.backup.*
*.map
