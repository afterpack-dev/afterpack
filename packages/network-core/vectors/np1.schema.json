                "frame"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "record": {
                  "type": "string"
                },
                "direction": {
                  "enum": [
                    "client-to-server",
                    "server-to-client"
                  ]
                },
                "kind": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 7
                },
                "wire": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{2})*$"
                },
                "frame": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{2})*$"
                },
                "frameText": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "rotation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "record",
          "serverSecrets",
          "body",
          "opensWithIndex"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "record": {
            "type": "string"
          },
          "serverSecrets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "body": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "opensWithIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "Index in serverSecrets of the key that opens the body."
          }
        }
      }
    },
    "negative": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "receiver",
          "transport",
          "input",
          "error",
          "intermediate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "receiver": {
            "enum": [
              "server",
              "client"
            ]
          },
          "transport": {
            "enum": [
              "http",
              "socket"
            ]
          },
          "serverSecrets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "The private keys a server receiver holds, tried in order."
          },
          "key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The session key a receiver already holds: a client's, or a server's after the socket's first frame."
          },
          "encoding": {
            "enum": [
              "raw",
              "base64",
              "base64url",
              "json"
            ],
            "description": "HTTP only. For a client, the encoding it expects; for a server, the encoding the body is in or looks like."
          },
          "frameType": {
            "enum": [
              "binary",
              "text"
            ],
            "description": "Socket only: the socket's frame type, taken from its first client frame."
          },
          "frameIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "Socket only: the frame's position among the frames this receiver has received; 0 is the first."
          },
          "input": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$",
            "description": "The bytes received: the outer body, or the frame."
          },
          "inputText": {
            "type": "string",
            "description": "input as text, for a text body or a text frame (a text frame is received as this string)."
          },
          "intermediate": {
            "description": "The values a receiver derives before it stops; inner is present when the record opens.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "wire": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})*$"
              },
              "ephPublic": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "shared": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "nonce": {
                "type": "string",
                "pattern": "^[0-9a-f]{48}$"
              },
              "box": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})*$"
              },
              "inner": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})*$"
              }
            }
          },
          "error": {
            "enum": [
              "bad-encoding",
              "truncated",
              "zero-shared",
              "open-failed",
              "malformed",
              "unsupported-version",
              "unknown-kind",
              "wrong-direction",
              "wrong-transport",
              "unexpected-handshake"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "receiver": {
                  "const": "client"
                }
              }
            },
            "then": {
              "required": [
                "key"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "receiver": {
                  "const": "server"
                }
              }
            },
            "then": {
              "required": [
                "serverSecrets"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "transport": {
                  "const": "socket"
                }
              }
            },
            "then": {
              "required": [
                "frameType",
                "frameIndex"
              ]
            },
            "else": {
              "required": [
                "encoding"
              ]
            }
          }
        ]
      }
    }
  }
}
